# Copy to .env and fill in secrets locally. Do NOT commit secrets.
# Core Flask / Azure AD
SECRET_KEY=change-me-to-random-secret
CLIENT_ID=your-azure-ad-client-id
TENANT_ID=your-azure-ad-tenant-id
MICROSOFT_PROVIDER_AUTHENTICATION_SECRET=your-app-registration-secret
LOGIN_REDIRECT_URL=https://your-app.azurewebsites.net/getAToken
HOME_REDIRECT_URL=https://your-app.azurewebsites.net/

# Azure Environment (public, usgovernment, custom)
AZURE_ENVIRONMENT=public

# Cosmos DB
AZURE_COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-key
AZURE_COSMOS_AUTHENTICATION_TYPE=key

# Azure OpenAI / Cognitive Services
AZURE_OPENAI_URL=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_GPT_ACCOUNT_NAME=vivche-openai-dev
AZURE_OPENAI_EMBEDDING_ACCOUNT_NAME=vivche-openai-dev
AZURE_OPENAI_IMAGE_GEN_ACCOUNT_NAME=tacd-openai
AZURE_OPENAI_SUBSCRIPTION_ID=e88b99f7-323e-408d-91b9-527f33c00ac7
AZURE_OPENAI_RESOURCE_GROUP_NAME=simplechat-rg

# Per-model endpoints (optional)
AZURE_OPENAI_EMBEDDING_URL=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_IMAGE_GEN_URL=https://tacd-openai.openai.azure.com/

# Azure Search
AZURE_SEARCH_SERVICE_NAME=your-search-service
AZURE_SEARCH_API_KEY=your-search-key

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.us/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your-doc-intel-key

# Redis (for sessions) - set if using Redis in production
# For local compose, use redis:6379
# REDIS_URL=your-redis.redis.cache.windows.net
# REDIS_KEY=your-redis-key

# Application settings
FLASK_ENV=development
PORT=8000
