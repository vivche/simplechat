// For format details, see https://aka.ms/devcontainer.json
{
	"name": "SimpleChat",
	
	// Use the existing Dockerfile to build the container
	"dockerFile": "../application/single_app/Dockerfile",
	"context": "..",
	
	// Pass environment variables from .env file and publish port
	"runArgs": [
		"--env-file=${localWorkspaceFolder}/application/single_app/.env",
		"-p", "8000:8000"
	],
	
	// Forward the Flask app port
	"forwardPorts": [8000],
	
	// Run as the non-root user created in Dockerfile
	"remoteUser": "appuser",
	
	// Override default command to keep container running for development
	"overrideCommand": true,
	
	// Start the Flask app in the background after container is created
	"postCreateCommand": "bash -c 'chmod +x /workspaces/simplechat/.devcontainer/start-app.sh && /workspaces/simplechat/.devcontainer/start-app.sh'",
	
	// VS Code extensions for Python development
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"github.copilot",
				"github.copilot-chat"
			],
			"settings": {
				"python.defaultInterpreterPath": "/app/venv/bin/python"
			}
		}
	}
}
