# Copy to .env and fill in your actual secrets. Do NOT commit the .env file with real secrets.

# Core Flask / Azure AD
SECRET_KEY=your-secret-key-here
CLIENT_ID=your-azure-ad-client-id
TENANT_ID=your-azure-ad-tenant-id
MICROSOFT_PROVIDER_AUTHENTICATION_SECRET=your-client-secret-value
LOGIN_REDIRECT_URL=http://localhost:8000/getAToken
HOME_REDIRECT_URL=http://localhost:8000/

# Azure Environment (public, usgovernment, custom)
AZURE_ENVIRONMENT=public

# Cosmos DB
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-primary-key
AZURE_COSMOS_AUTHENTICATION_TYPE=key

# Azure OpenAI / Cognitive Services
AZURE_OPENAI_URL=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_GPT_ACCOUNT_NAME=your-openai-account-name
AZURE_OPENAI_EMBEDDING_ACCOUNT_NAME=your-openai-account-name
AZURE_OPENAI_IMAGE_GEN_ACCOUNT_NAME=your-image-gen-account-name
AZURE_OPENAI_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_OPENAI_RESOURCE_GROUP_NAME=your-resource-group-name

# Per-model endpoints (optional)
AZURE_OPENAI_EMBEDDING_URL=https://eastus2.api.cognitive.microsoft.com/
AZURE_OPENAI_IMAGE_GEN_URL=https://your-openai-account.openai.azure.com/

# Azure Search
AZURE_SEARCH_SERVICE_NAME=your-search-service-name
AZURE_SEARCH_API_KEY=your-search-api-key

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-docintel-account.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=your-document-intelligence-key

# Redis (for sessions) - set if using Redis in production
# For local compose, use redis:6379
# REDIS_URL=your-redis.redis.cache.windows.net
# REDIS_KEY=your-redis-key

# Application settings
FLASK_ENV=development
PORT=8000

# Application Insights
APPINSIGHTS_INSTRUMENTATIONKEY=your-appinsights-instrumentation-key
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://eastus2-3.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus2.livediagnostics.monitor.azure.com/;ApplicationId=your-app-id
